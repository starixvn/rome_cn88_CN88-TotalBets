@model MatchSummaryMenuViewModel
<div id="summary-menu" class="menu-container">
    <div id="head-menu" class="head-menu">
        <div class="collapse-expand-summary-menu -left"><span class="icon-left-menu"></span></div>
        <span class="icon-menu"></span>
        <div class="menu">@Resources.Menu</div>
        <div class="collapse-expand-summary-menu -right"><span class="icon-left-menu"></span></div>
    </div>
    <div id="summary-menu-items" class="summary-menu-items">
        <a href="@Model.SummaryPath" class="menu-item back-to-sum"><span class="icon-chevron-left"></span>@Resources.BackToSummary</a>
        @if (Model.Summary.SportTypeGroup == 0)
        {
            @Resources.NoInformationIsAvailable
        }
        else
        {
            var summary = Model.Summary;
            <div class="menu-item sport">
                <div class="name">
                    <div class="txt">@summary.SportTypeGroupName</div>
                    <div>
                        <span class="number-first">@HtmlHelpers.FormatNumber(summary.Wager)</span>|<span class="number-second">@HtmlHelpers.FormatNumber(summary.Stake)</span>
                    </div>
                </div>
                <span class="icon-chevron-down"></span>
            </div>
            foreach (var league in summary.LeagueSummaries)
            {
                <div class="menu-item league-wrapper" id="@league.LeagueId">
                    <div class="name league">
                        <div class="txt">@league.LeagueName</div>
                        <div>
                            <span class="number-first">@HtmlHelpers.FormatNumber(league.Wager)</span>|<span class="number-second">@HtmlHelpers.FormatNumber(league.Stake)</span>
                        </div>
                    </div>
                    <span class="icon-chevron-down"></span>
                </div>
                <ul class="list-sports child-@league.LeagueId">
                    @foreach (var match in league.MatchSummaries)
                    {
                        var path = $"{Model.ViewByBetTypePath}&MatchId={match.MatchId}";
                        <li id="@match.MatchId" class="sport @(match.MatchId==Model.SelectedMatchId ? "selected" : string.Empty)">
                            <a href="@path">
                                <div class="txt">@match.HomeTeamName</div>
                                <div class="txt">@match.AwayTeamName</div>
                                <div>
                                    <span class="number-first">@HtmlHelpers.FormatNumber(match.Wager)</span>|<span class="number-second">@HtmlHelpers.FormatNumber(match.Stake)</span>
                                </div>
                            </a>
                        </li>
                    }
                </ul>
            }
        }
    </div>
</div>