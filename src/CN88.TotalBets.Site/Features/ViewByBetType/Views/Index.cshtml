@{
    ViewBag.Title = "View By Bet Type";
    Layout = "~/Shared/Views/_Layout.cshtml";
}

@model ViewByBetTypeViewModel

<div class="league">@Model.LeagueName <span>@Model.TotalWager</span>|<span>@Model.TotalStake</span></div>
<div class="show-time">@Model.Match.ShowTime</div>
<div class="score">@Model.Match.LiveHomeScore - @Model.Match.LiveAwayScore</div>

@foreach (var bettype in Model.TotalBetsByBetTypes)
{
    <div>@CacheRefManager.CacheRefInstance.GetBetTypeName(bettype.BetTypeId)</div>

    foreach (var betOptionGroup in bettype.BetOptionGroups)
    {
        if (betOptionGroup.BetOptions.Any())
        {
            <div>@(betOptionGroup.IsLive ? "In-Play" : "Pre-Match")</div>
            <div>
                @foreach (var betOption in betOptionGroup.BetOptions)
                {
                <span>
                    <span>@betOption.BetTeam</span>
                    <span>@betOption.Wager</span>
                    <span>@betOption.Stake</span>
                </span>
                }
            </div>
            }
        }
}