@{
    ViewBag.Title = Model.Title;
    Layout = "~/Shared/Views/_Layout.cshtml";
    var betOptionBuilderFactory = new BetOptionBuilderFactoryImpl();
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/viewbybettype/viewbybettype")
}
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/viewbybettype/index")
}
@model ViewByBetTypeViewModel
@Html.Partial("~/Features/ViewByBetType/Views/MatchSummaryMenu.cshtml", Model.MatchSummaryMenuViewModel)
<div class="main-content" id="main-content">
    @Html.Partial("~/Shared/Views/Filter.cshtml", Model.FilterViewModel)
    @if (Model.IsInPlay)
    {
        <button type="button" class="btn-submit btn-refresh" id="btn-refresh">
            <span class="icon-refresh"></span>
            <span id="countDownContainer">..</span>
        </button>
    }
    <div class="viewbettype-content">
        @RenderMatch(Model)
        <table class="tbl-style2 tbl-totalbet tbl-viewbettype" id="tblTotalBets">
            <tbody>
                @if (Model.TotalBetsByBetTypes.Any())
                {
                    foreach (var bettype in Model.TotalBetsByBetTypes)
                    {

                        @RenderBetType(bettype)
                        @RenderBetOptions(bettype, Model.Match, betOptionBuilderFactory)
                    }
                }
                else
                {
                    <tr><td class="text-center no-info">@Resources.NoInformationIsAvailable</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
@helper RenderMatch(ViewByBetTypeViewModel model)
{
    <div class="league">@Model.LeagueName <span class="index pull-right"><span>@Model.TotalWager</span> | <span class="link">@Model.TotalStake</span></span></div>

    <div class="head-match">
        <div class="show-time">@Html.Raw(@Model.Match.ShowTime)</div>
        <div class="match">
            <span class="team-name">@Model.HomeName</span>
            <span class="score">@Model.Match.LiveHomeScore - @Model.Match.LiveAwayScore</span>
            <span class="team-name">@Model.AwayName</span>
        </div>
    </div>
}
@helper RenderBetType(TotalBetsByBetType betType)
{
    <tr class="group">
        <td colspan="2">
            <span class="group-name-wrapper">
                <span class="icon-chevron-down"></span>
                <span class="group-name">@CacheRefManager.CacheRefInstance.GetBetTypeName(betType.BetTypeId)</span>
            </span>
            <span class="index text-right">@HtmlHelpers.FormatNumber(betType.TotalWager) | @HtmlHelpers.FormatNumber(betType.TotalStake)</span>
        </td>
    </tr>
}
@helper RenderBetOptions(
    TotalBetsByBetType betType,
    CN88.TotalBets.Features.Events.Models.Match match,
    BetOptionBuilderFactory betOptionBuilderFactory)
{
foreach (var betOptionGroup in betType.BetOptionGroups)
{
    if (betOptionGroup.BetOptions.Any())
    {
            <tr class="bet-option">
                <td colspan="2">@(betOptionGroup.LiveText)</td>
            </tr>

        foreach (var betOption in betOptionGroup.BetOptions)
        {
                <tr>
                    <td class="team">
                        <span class="team-name">
                            @(betOptionBuilderFactory
                                .CreateBetOptionBuilder(betOption.BetTypeId)?
                                .BuildBetChoice(betOption.BetTeam, match))
                        </span>
                        <span class="index text-right">
                            @HtmlHelpers.FormatNumber(betOption.Wager)
                            <span class="stake link">@HtmlHelpers.FormatNumber(betOption.Stake)</span>
                        </span>
                    </td>
                </tr>
        }
    }
}
}