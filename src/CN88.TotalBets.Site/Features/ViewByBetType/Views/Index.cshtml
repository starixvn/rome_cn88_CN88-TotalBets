@{
                /**/

                ViewBag.Title = Model.Title;
                Layout = "~/Shared/Views/_Layout.cshtml";
                var betOptionBuilderFactory = new BetOptionBuilderFactoryImpl();
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/viewbybettype/viewbybettype")
}
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/viewbybettype/index")
}
@model ViewByBetTypeViewModel
@Html.Partial("~/Features/ViewByBetType/Views/MatchSummaryMenu.cshtml", Model.MatchSummaryMenuViewModel)


<div class="main-content" id="main-content">
    @Html.Partial("~/Shared/Views/Filter.cshtml", Model.FilterViewModel)
    @if (Model.ViewFromInPlayPage)
    {
        <button type="button" class="btn-submit btn-refresh" id="btn-refresh">
            <span class="icon-refresh"></span>
            <span id="countDownContainer">..</span>
        </button>
    }
    <div class="viewbettype-content">
        @RenderMatch(Model)
        <table class="tbl-style2 tbl-totalbet tbl-viewbettype" id="tblTotalBets">
            <tbody>
                @if (Model.TotalBetsByBetTypes.Any())
                {
                    foreach (var bettype in Model.TotalBetsByBetTypes)
                    {
                        @RenderBetType(bettype, betOptionBuilderFactory)
                        @RenderBetOptions(bettype, Model.Match, betOptionBuilderFactory, Model.ViewFromInPlayPage)
                    }
                }
                else
                {
                    <tr><td class="text-center no-info">@Resources.NoInformationIsAvailable</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>


@helper RenderMatch(ViewByBetTypeViewModel model)
{
    if (model.Match != null)
    {
        <div class="league">@Model.LeagueName <span class="index pull-right"><span>@HtmlHelpers.FormatNumber(Model.TotalWager)</span> | <span class="link">@HtmlHelpers.FormatNumber(Model.TotalStake)</span></span></div>

        <div class="head-match">
            <div class="show-time">@HtmlHelpers.ShowTime(Model.Match.ShowTimeDT, Model.Match.OfferLive, Model.ViewFromEarlyPage)</div>
            <div class="match">
                <span class="team-name">@Model.Match.HomeName</span>
                @if (model.Match.IsShowScore)
                {
                    <span class="score">@Model.Match.LiveHomeScore - @Model.Match.LiveAwayScore</span>
                }
                else
                {
                    <span class="vs"> V </span>
                }
                <span class="team-name">@Model.Match.AwayName</span>
            </div>
        </div>
    }
}

@helper RenderBetType(
    TotalBetsByBetType betType,
    BetOptionBuilderFactory betOptionBuilderFactory)
{
    <tr class="group" data-leagueid="@betType.BetTypeId">
        <td colspan="2">
            <span class="group-name-wrapper">
                <span class="icon-chevron-down"></span>
                <span class="group-name">
                    @(betOptionBuilderFactory.IsUseDefaultBetOptionBuider(betType.BetTypeId)
                                        ? Resources.OtherBetTypes
                                        : CacheRefManager.CacheRefInstance.GetBetTypeName(betType.BetTypeId)
                    )
                </span>
            </span>
            <span class="index text-right">@HtmlHelpers.FormatNumber(betType.TotalWager) | <span class="link">@HtmlHelpers.FormatNumber(betType.TotalStake)</span></span>
        </td>
    </tr>
}
@helper RenderBetOptions(
    TotalBetsByBetType betType,
    CN88.TotalBets.Features.Events.Models.Match match,
    BetOptionBuilderFactory betOptionBuilderFactory,
    bool viewFromInPlayPage)
{
    var betOptionParams = new Dictionary<string, object> { { "viewFromInPlayPage", Model.ViewFromInPlayPage } };

    foreach (var betOptionGroup in betType.BetOptionGroups)
    {
        if (betOptionGroup.BetOptions.Any())
        {
            if (!betOptionBuilderFactory.IsUseDefaultBetOptionBuider(betType.BetTypeId)
                && viewFromInPlayPage)
            {
                <tr class="bet-option childrow-@betType.BetTypeId">
                    <td colspan="2">@(betOptionGroup.LiveText)</td>
                </tr>
            }

            <tr class="childrow-@betType.BetTypeId">
                <td class="bet-team-container">
                    <div class="bet-team-wrapper">
                        @foreach (var betOption in betOptionGroup.BetOptions)
                        {
                            <div class="bet-team">
                                <span class="team-name">
                                    @if (betOptionBuilderFactory.IsUseDefaultBetOptionBuider(betType.BetTypeId))
                                    {
                                        @CacheRefManager.CacheRefInstance.GetBetTypeName(betOption.BetTypeId)
                                    }
                                    else
                                    {
                                        @(betOptionBuilderFactory
                                                    .CreateBetOptionBuilder(betOption.BetTypeId)
                                                    ?.BuildBetChoice(betOption, match, betOptionParams))
                                    }
                                </span>
                                <span class="index text-right">
                                    @BuildWagerAndStake(betOption)
                                </span>
                            </div>
                        }
                    </div>
                </td>
            </tr>
        }
    }
}

@helper BuildWagerAndStake(BetOption betOption)
{
    @HtmlHelpers.FormatNumber(betOption.Wager)

    if (betOption.Stake > 0)
    {
        @Html.ActionLink(
        HtmlHelpers.FormatNumber(betOption.Stake).ToHtmlString(),
        "GetByEvent",
        "WagerAccount",
        Model.GetWagerAccountParams(betOption.BetTypeId, betOption.BetTeam),
        new { @class = "stake link" })
    }
    else
    {
        <span class="stake">
            @HtmlHelpers.FormatNumber(betOption.Stake).ToHtmlString()
        </span>
    }

}