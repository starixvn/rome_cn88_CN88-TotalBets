@{
    ViewBag.Title = "Total Bets";
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/events/event")
}
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/events/index")
}
@model EventViewModel
@SummaryMenu.Render(Model.SummaryMenuViewModel)
<div class="main-content" id="main-content">
    <div class="page-title">
        <div>@Model.Title</div>
        <div class="event">@Model.SubTitle</div>
    </div>
    @{ Html.RenderPartial("~/Shared/Views/Filter.cshtml", Model.FilterViewModel); }
    @if (Model.IsInPlay)
    {
        <button type="button" class="btn-submit btn-refresh" id="btn-refresh">
            <span class="icon-refresh"></span>
            <span id="countDownContainer">..</span>
        </button>
    }
    <table class="tbl-style2 tbl-totalbet" id="tblTotalBets">
        @if (Model.HasEventData)
        {
            <tbody>
                <tr><td colspan="5" class="text-center no-info">@Resources.NoInformationIsAvailable</td></tr>
            </tbody>
        }
        else
        {
            <thead>
                <tr>
                    <th class="col-100">@(Model.IsInPlay ? Resources.Details : Resources.Time)</th>
                    <th>@Resources.Event</th>
                    <th class="col-100 text-right">@Resources.Wagers [@HtmlHelpers.FormatNumber(Model.EventModel.TotalWager)]</th>
                    <th class="col-180 text-right">@Resources.Stake [@HtmlHelpers.FormatNumber(Model.EventModel.TotalStake)]</th>
                    <th class="col-80">&nbsp;</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var league in Model.EventModel.MatchLeagues)
                {
                    <tr class="group" data-leagueid="@league.LeagueId">
                        <td colspan="5">
                            <span class="group-name-wrapper">
                                <span class="icon-chevron-down"></span>
                                <span class="group-name">@league.LeagueName</span>
                            </span>
                        </td>
                    </tr>
                    foreach (var match in league.Matches)
                    {
                        <tr class="childrow-@league.LeagueId">
                            <td>@RenderScoreColumn(match)</td>
                            <td>@match.Event</td>
                            <td class="text-right">@HtmlHelpers.FormatNumber(match.Wager)</td>
                            <td class="text-right">
                                @RenderViewByBetTypeLink(HtmlHelpers.FormatNumber(match.Stake).ToHtmlString(), match.MatchId)
                            </td>
                            <td class="text-right">
                                @RenderViewByBetTypeLink(HtmlHelpers.FormatNumber(match.BetTypeCount).ToHtmlString(), match.MatchId, "bettypecount")
                            </td>
                        </tr>
                    }
                }
            </tbody>
        }
    </table>
</div>
@helper RenderScoreColumn(Match match)
{
if (Model.IsInPlay)
{
        @:@match.LiveHomeScore - @match.LiveAwayScore<br />
        <span class="live">@Resources.Live</span>
}
else
{
        @:@Html.Raw(match.ShowTime)
    }
}
@helper RenderViewByBetTypeLink(string title, int matchId, string className = null)
{
    <a href="@Url.Action(
        "Index",
        "ViewByBetType",
        new
        {
            matchId = matchId,
            stake = Model.FilterViewModel.Stake,
            stakeCondition = Model.FilterViewModel.StakeCondition,
            type = Model.Query.Type,
            marketType = Model.Query.Market
        })" class="link @className">
        @title
        @if (className != null)
        {
            <span class="icon-chevron-right"></span>
        }
    </a>
}