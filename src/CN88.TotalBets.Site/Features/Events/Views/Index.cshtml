@{
    ViewBag.Title = "Total Bets";
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/events/event")
}
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/events/event")
}
@model EventViewModel
@SummaryMenu.Render(Model.SummaryMenuViewModel)
<div class="main-content">
    <div class="page-title">
        <div>@Model.Title</div>
        <div class="event">@Model.SubTitle</div>
    </div>
    @{ Html.RenderPartial("~/Features/Events/Views/Filter.cshtml", Model.FilterViewModel); }
    @if (Model.EventModel.TotalWager == 0)
    {
        Html.RenderPartial("~/Features/Events/Views/_TableNoDataFound.cshtml", 5);
    }
    else
    {
        Html.RenderPartial("~/Features/Events/Views/_InPlay.cshtml", Model);
    }
</div>