@{
    ViewBag.Title = Resources.Outright;
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/outright/outright")
}
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/outright/index")
}
@model OutrightViewModel
@SummaryMenu.Render(Model.SummaryMenuViewModel)
<div class="main-content" id="main-content">
    <div class="page-title">
        <div class="main-title">@Model.Title</div>
        <div class="sub-title">
            <div class="event">@Model.SubTitle</div>
            <span class="icon-filter-down" id="filter-toggle-icon"></span>
        </div>
    </div>
    @{ Html.RenderPartial("~/Shared/Views/Filter.cshtml", Model.FilterViewModel); }
    <table class="tbl-style2 tbl-totalbet tbl-outright" id="tblTotalBets">
        <tbody>
            @if (Model.TeamLeagues.Any())
            {
                foreach (var league in Model.TeamLeagues)
                {
                    @RenderLeague(league)
                    var index = 0;
                    foreach (var team in league.Teams)
                    {
                        index++;
                        if (index % 2 == 1)
                        {
                            @:<tr class="childrow-@league.LeagueId">@RenderOutright(team)
                        }
                        else
                        {
                            @:@RenderOutright(team)</tr>
                        }
                    }

                    if (index % 2 == 1)
                    {
                        @:<td class="col-empty">&nbsp;</td></tr>
                    }
                }
            }
            else
            {
                <tr class="row-no-info"><td colspan="2" class="text-center no-info">@Resources.NoInformationIsAvailable</td></tr>
            }
        </tbody>
    </table>
</div>
@Html.Hidden("IsDevice", Model.IsDevices ? 1 : 0)
@helper RenderLeague(TeamLeague league)
{
    <tr class="group" data-leagueid="@league.LeagueId">
        <td colspan="2">
            <span class="group-name-wrapper">
                <span class="icon-chevron-down"></span>
                <span class="group-name">@league.LeagueName</span>
            </span>
            <span class="index text-right">@HtmlHelpers.FormatNumber(league.TotalWager) | @HtmlHelpers.FormatNumber(league.TotalStake)</span>
        </td>
    </tr>
}
@helper RenderOutright(Team team)
{
    <td class="team">
        <span class="team-name">@team.TeamName</span>
        <span class="index text-right">@HtmlHelpers.FormatNumber(team.Wager)
            @Html.ActionLink(
                HtmlHelpers.FormatNumber(team.Stake).ToHtmlString(),
                "GetByOutright",
                "WagerAccount",
                Model.GetWagerAccountParams(team.MatchId),
                new { @class = "stake link" })
        </span>
    </td>
}
