@model DateSelectionViewModel
<div class="form-group dropdown-date-type">
    <label>@Resources.Date</label>
    <select id="dropdown-date-type">
        @foreach (var item in Model.Items)
            {
            <option value="@item.Value" @(item.Selected ? " selected=\"selected\"" : string.Empty)>@item.Text</option>
        }
    </select>
    <input type="hidden" name="DateType" id="DateType" value="@Model.SelectedItem" />
</div>