@{
    ViewBag.Title = "Total Bets";
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/started/started")
}
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/started/index")
}
@model StartedViewModel
@SummaryMenu.Render(Model.SummaryMenuViewModel)
<div class="main-content" id="main-content">
    <div class="page-title">
        <div>@Model.Title</div>
        <div class="event">@Model.SubTitle</div>
    </div>
    @Html.Partial("~/Shared/Views/Filter.cshtml", Model.FilterViewModel)
    <button type="button" class="btn-submit btn-refresh" id="btn-refresh">
        <span class="icon-refresh"></span>
        <span id="countDownContainer">..</span>
    </button>
    <table class="tbl-style2 tbl-totalbet tbl-started" id="tbl-started">
        <thead>
            <tr>
                <th class="col-100 text-center">@Resources.Time</th>
                <th class="col-120 text-center">@Resources.Details</th>
                <th class="col-320">@Resources.Event</th>
                <th class="col-100">@Resources.Wagers</th>
                <th class="col-100 text-right">[@HtmlHelpers.FormatNumber(Model.TotalWager)]</th>
                <th class="col-180 text-right">@Resources.Stake [@HtmlHelpers.FormatNumber(Model.TotalStake)]</th>
                <th class="col-80">&nbsp;</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Data.Any())
            {
                <tr class="total">
                    <td>@Resources.Total</td>
                    <td colspan="2"></td>
                    <td><div class="PM">@Resources.PM</div><div class="IP">@Resources.IP</div></td>
                    <td class="text-right">
                        <div class="PM">
                            @HtmlHelpers.FormatNumber(Model.TotalPMWager)
                        </div>
                        <div class="IP">
                            @HtmlHelpers.FormatNumber(Model.TotalIPWager)
                        </div>
                    </td>
                    <td class="text-right">
                        <div class="PM">
                            @HtmlHelpers.FormatNumber(Model.TotalPMStake)
                        </div>
                        <div class="IP">
                            @HtmlHelpers.FormatNumber(Model.TotalIPStake)
                        </div>
                    </td>
                    <td></td>
                </tr>
                foreach (var league in Model.Data)
                {
                    <tr class="group" data-leagueid="@league.LeagueId">
                        <td colspan="3">
                            <span class="group-name-wrapper">
                                <span class="icon-chevron-down"></span>
                                <span class="group-name">@league.LeagueName</span>
                            </span>
                        </td>
                        <td><div class="PM">@Resources.PM</div><div class="IP">@Resources.IP</div></td>
                        <td class="text-right">
                            <div class="PM">
                                @HtmlHelpers.FormatNumber(league.TotalPMWager)
                            </div>
                            <div class="IP">
                                @HtmlHelpers.FormatNumber(league.TotalIPWager)
                            </div>
                        </td>
                        <td class="text-right">
                            <div class="PM">
                                @HtmlHelpers.FormatNumber(league.TotalPMStake)
                            </div>
                            <div class="IP">
                                @HtmlHelpers.FormatNumber(league.TotalIPStake)
                            </div>
                        </td>
                        <td></td>
                    </tr>
                    foreach (var match in league.Matches)
                    {
                        <tr class="childrow-@league.LeagueId">
                            <td class="text-center">@HtmlHelpers.ShowTime(match.ShowTimeDT, match.OfferLive, Model.ShowDate)</td>
                            <td class="details">
                                <div class="half HT"><div class="title">@Resources.HT</div>@match.HTHomeScore - @match.HTAwayScore</div>
                                <div class="half FT"><div class="title">@Resources.FT</div>@match.LiveHomeScore - @match.LiveAwayScore</div>
                                @if (match.LiveType)
                                {
                                    <div class="live">@Resources.Live</div>
                                }
                            </td>
                            <td>@match.HomeName v @match.AwayName</td>
                            <td><div class="PM">@Resources.PM</div><div class="IP">@Resources.IP</div></td>
                            <td class="text-right">
                                <div class="PM">@HtmlHelpers.FormatNumber(match.PMWager)</div>
                                <div class="IP">@HtmlHelpers.FormatNumber(match.IPWager)</div>
                            </td>
                            <td class="text-right">
                                <div class="PM">
                                    @if (match.PMWager > 0)
                                    {
                                        @RenderViewByBetTypeLink(HtmlHelpers.FormatNumber(match.PMStake).ToHtmlString(), match.MatchId)
                                    }
                                    else
                                    {
                                        @HtmlHelpers.FormatNumber(match.PMStake);
                                    }
                                </div>
                                <div class="IP">
                                    @if (match.IPWager > 0)
                                    {
                                        @RenderViewByBetTypeLink(HtmlHelpers.FormatNumber(match.PMStake).ToHtmlString(), match.MatchId)
                                    }
                                    else
                                    {
                                        @HtmlHelpers.FormatNumber(match.IPStake)
                                    }
                                </div>
                            </td>
                            <td class="text-right">@RenderViewByBetTypeLink(HtmlHelpers.FormatNumber(match.BetTypeCount).ToHtmlString(), match.MatchId, "bettypecount")</td>
                        </tr>
                    }
                }
            }
            else
            {
                <tr><td colspan="7" class="text-center no-info">@Resources.NoInformationIsAvailable</td></tr>
            }
        </tbody>
    </table>
</div>
@helper RenderViewByBetTypeLink(string text, int matchId, string className = null)
{
    <a href="@Url.Action(
            "Index",
            "ViewByBetType",
            new {
                matchId = matchId,
                stake = Model.FilterViewModel.Stake,
                stakeCondition = Model.FilterViewModel.StakeCondition,
                type = EventTypeConstants.Started,
                sportTypeGroup = Model.FilterViewModel.SportTypeGroup,
                market = Model.FilterViewModel.Market,
                possType = Model.FilterViewModel.PossTypeSelectionViewModel.UserSelectedId,
            })" class="link @className">
        @text
        @if (className != null)
        {
            <span class="icon-chevron-right"></span>
        }
    </a>
}