@model HomeViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/overview")
}
<div class="page-overview">
    <div class="page-title">@Resources.OverView</div>
    <form class="form-inline filter" role="form" id="overview-form">
        @PossTypeSelection.Render(Model.PossType)
    </form>
    <table class="tbl-style2 tbl-total">
        <tbody>
            <tr>
                <td>@Resources.TotalWarger</td>
                <td>@HtmlHelpers.FormatNumber(Model.Total.Wagers)</td>
            </tr>
            <tr>
                <td>@Resources.TotalStake</td>
                <td>@HtmlHelpers.FormatNumber(Model.Total.Stake)</td>
            </tr>
        </tbody>
    </table>

    <table class="tbl-style2 tbl-betdetail">
        <thead>
            <tr>
                <th></th>
                <th class="text-center">@Resources.AllSports</th>
                @for (var i = 0; i < Model.HeaderTable.HeaderName.Count; i++)
                {
                    <th class="text-center"><span data-toggle="tooltip" data-placement="top" title="@Model.HeaderTable.ToolTip[i]">@Model.HeaderTable.HeaderName[i]</span></th>
                }

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.BySportType)
            {
                <tr>
                    <td>@item.Text</td>
                    <td>
                        <span>@HtmlHelpers.FormatNumber(item.Total.Wagers)</span>
                        <span>@HtmlHelpers.FormatNumber(item.Total.Stake)</span>
                    </td>
                    <td>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Soccer.Wagers, item.Url(Model.PossType, item.Soccer.Stake))</span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Soccer.Stake, item.Url(Model.PossType, item.Soccer.Stake))</span>
                    </td>
                    <td class="even">
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.Basketball.Wagers, item.Url(Model.PossType, item.Basketball.Stake))
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Basketball.Stake, item.Url(Model.PossType, item.Basketball.Stake))</span>
                    </td>
                    <td>
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.Tennis.Wagers, item.Url(Model.PossType, item.Tennis.Stake))
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Tennis.Stake, item.Url(Model.PossType, item.Tennis.Stake))</span>
                    </td>
                    <td class="even">
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.Volleyball.Wagers, item.Url(Model.PossType, item.Volleyball.Stake))
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Volleyball.Stake, item.Url(Model.PossType, item.Volleyball.Stake))</span>
                    </td>
                    <td>
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.TableTennis.Wagers, item.Url(Model.PossType, item.TableTennis.Stake))
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.TableTennis.Stake, item.Url(Model.PossType, item.TableTennis.Stake))</span>
                    </td>
                    <td class="even">
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.Badminton.Wagers, item.Url(Model.PossType, item.Badminton.Stake))
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Badminton.Stake, item.Url(Model.PossType, item.Badminton.Stake))</span>
                    </td>
                    <td>
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.Baseball.Wagers, item.Url(Model.PossType, item.Baseball.Stake))
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Baseball.Stake, item.Url(Model.PossType, item.Baseball.Stake))</span>
                    </td>
                    <td class="even">
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.Snooker.Wagers, item.Url(Model.PossType, item.Snooker.Stake))
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Snooker.Stake, item.Url(Model.PossType, item.Snooker.Stake))</span>
                    </td>
                    <td>
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.OtherSports.Wagers, item.Url(Model.PossType, item.OtherSports.Stake))
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.OtherSports.Stake, item.Url(Model.PossType, item.OtherSports.Stake))</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <table class="tbl-style2 tbl-betdetail">
        <thead>
            <tr>
                <th></th>
                <th class="text-center">@Resources.AllParlays</th>
                <th class="text-center">@Resources.Soccer</th>
                <th class="text-center">@Resources.NonSoccer</th>
                <th class="text-center">@Resources.MixSports</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.ByParlay.Text</td>
                <td>
                    <span>
                        @HtmlHelpers.FormatNumber(Model.ByParlay.Total.Wagers)
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumber(Model.ByParlay.Total.Stake)
                    </span>
                </td>
                <td>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.Soccer.Wagers, "")
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.Soccer.Stake, "")
                    </span>
                </td>
                <td class="even">
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.NonSoccer.Wagers, "")
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.NonSoccer.Stake, "")
                    </span>
                </td>
                <td>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.MixSports.Wagers, "")
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.MixSports.Stake, "")
                    </span>
                </td>
            </tr>
        </tbody>
    </table>
</div>

@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/scripts/overview")
}