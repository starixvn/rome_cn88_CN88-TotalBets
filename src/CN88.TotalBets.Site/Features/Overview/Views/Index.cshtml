@model HomeViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/overview/overview")
}
<div class="page-overview">
    <div class="page-title">@Resources.OverView</div>
    <form class="form-inline filter" role="form" id="overview-form">
        @PossTypeSelection.Render(Model.PossTypeSelectionViewModel)
    </form>
    <table class="tbl-style2 tbl-total">
        <tbody>
            <tr>
                <td>@Resources.TotalWarger</td>
                <td>@HtmlHelpers.FormatNumber(Model.Total.Wagers)</td>
            </tr>
            <tr>
                <td>@Resources.TotalStake</td>
                <td>@HtmlHelpers.FormatNumber(Model.Total.Stake)</td>
            </tr>
        </tbody>
    </table>
    <table class="tbl-style2 tbl-betdetail">
        <thead>
            <tr>
                <th></th>
                <th class="text-center">@Resources.AllSports</th>
                @for (var i = 0; i < Model.HeaderTable.HeaderName.Count; i++)
                {
                    <th class="text-center"><span data-toggle="tooltip" data-placement="top" title="@Model.HeaderTable.ToolTip[i]">@Model.HeaderTable.HeaderName[i]</span></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.BySportType)
            {
                <tr>
                    <td>@row.Text</td>
                    <td>
                        <span>@HtmlHelpers.FormatNumber(row.Total.Wagers)</span>
                        <span>@HtmlHelpers.FormatNumber(row.Total.Stake)</span>
                    </td>
                    @foreach(var sportColumn in row.SportsColumn)
                    {
                        <td>
                            <span>@HtmlHelpers.FormatNumberWithLink(sportColumn.Wagers, row.Url(Model.PossType, sportColumn.SportTypeGroup), row.SubMenuId)</span>
                            <span>@HtmlHelpers.FormatNumberWithLink(sportColumn.Stake, row.Url(Model.PossType, sportColumn.SportTypeGroup), row.SubMenuId)</span>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    <table class="tbl-style2 tbl-betdetail">
        <thead>
            <tr>
                <th></th>
                <th class="text-center">@Resources.AllParlays</th>
                <th class="text-center">@Resources.Soccer</th>
                <th class="text-center">@Resources.NonSoccer</th>
                <th class="text-center">@Resources.MixSports</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.ByParlay.Text</td>
                <td>
                    <span>
                        @HtmlHelpers.FormatNumber(Model.ByParlay.Total.Wagers)
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumber(Model.ByParlay.Total.Stake)
                    </span>
                </td>
                <td>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.Soccer.Wagers, "", Model.ByParlay.SubMenuId)
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.Soccer.Stake, "", Model.ByParlay.SubMenuId)
                    </span>
                </td>
                <td class="even">
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.NonSoccer.Wagers, "", Model.ByParlay.SubMenuId)
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.NonSoccer.Stake, "", Model.ByParlay.SubMenuId)
                    </span>
                </td>
                <td>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.MixSports.Wagers, "", Model.ByParlay.SubMenuId)
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.MixSports.Stake, "", Model.ByParlay.SubMenuId)
                    </span>
                </td>
            </tr>
        </tbody>
    </table>
</div>
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/overview/index")
}