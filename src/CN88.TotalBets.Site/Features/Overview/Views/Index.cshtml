@model HomeViewModel
@{
    ViewBag.Title = Resources.OverView;
    Layout = "~/Shared/Views/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/overview/overview")
}
<div class="page-overview">
    <div class="page-title">@Resources.OverView</div>
    <form class="form-inline filter" role="form" id="overview-form">
        @PossTypeSelection.Render(Model.PossTypeSelectionViewModel)
    </form>
    @Html.Partial("~/Features/Overview/Views/TotalTable.cshtml", Model)
    @if (Model.IsDevices)
    {
        @Html.Partial("~/Features/Overview/Views/MobileSportsTable.cshtml", Model)
    }
    else
    {
        @Html.Partial("~/Features/Overview/Views/SportsTable.cshtml", Model)
    }

    @Html.Partial("~/Features/Overview/Views/ParlayTable.cshtml", Model)
</div>
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/overview/index")
}