@model HomeViewModel
<ul id="sport-groups" class="group-list">
    <li class="group active">
        <div class="group-title">
            <div class="lbl">@Resources.AllSports</div>
            @{
                var allTotal = Model.GetTotal(-1);
                <div class="values">
                    <div class="value-detail">@HtmlHelpers.FormatNumber(allTotal.Wager)</div>
                    <div class="value-detail">@HtmlHelpers.FormatNumber(allTotal.Stake)</div>
                </div>
            }
        </div>
        <ul class="list-item">
            @for (var j = 0; j < Model.BySportType.Count(); j++)
            {
                var row = Model.BySportType.ElementAt(j);
                <li class="item">
                    <div class="lbl">@row.Text</div>
                    <div class="values text-right">
                        <div class="value-detail">@HtmlHelpers.FormatNumber(row.Total.Wager)</div>
                        <div class="value-detail">@HtmlHelpers.FormatNumber(row.Total.Stake)</div>
                    </div>
                </li>
            }
        </ul>
    </li>
    @for (var i = 0; i < Model.HeaderTable.HeaderName.Count; i++)
    {
        <li class="group">
            <div class="group-title">
                <span data-toggle="tooltip" data-placement="top" title="@Model.HeaderTable.ToolTip[i]">@Model.HeaderTable.HeaderName[i]</span>
                @{
                    var total = Model.GetTotal(i);
                    <div class="values">
                        <div class="value-detail">@HtmlHelpers.FormatNumber(total.Wager)</div>
                        <div class="value-detail">@HtmlHelpers.FormatNumber(total.Stake)</div>
                    </div>
                }
            </div>
            <ul class="list-item" style="display: none;">
                @for (var j = 0; j < Model.BySportType.Count(); j++)
                {
                    var row = Model.BySportType.ElementAt(j);
                    var sportColumn = row.SportsColumn[i];
                    <li class="item">
                        <div class="lbl">@row.Text</div>
                        <div class="values">
                            <div class="value-detail">@HtmlHelpers.FormatNumberWithLink(sportColumn.Wager, row.Url(Model.PossType, sportColumn.SportTypeGroup), row.SubMenuId)</div>
                            <div class="value-detail">@HtmlHelpers.FormatNumberWithLink(sportColumn.Stake, row.Url(Model.PossType, sportColumn.SportTypeGroup), row.SubMenuId)</div>
                        </div>
                    </li>
                }
            </ul>
        </li>
                    }
</ul>