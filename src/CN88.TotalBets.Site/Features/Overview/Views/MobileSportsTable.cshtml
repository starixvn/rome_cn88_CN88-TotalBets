@model HomeViewModel
<ul>
    <li>
        @Resources.AllSports
        <ul>
            @for (var j = 0; j < Model.BySportType.Count(); j++)
            {
                var row = Model.BySportType.ElementAt(j);
                <li>
                    <span>@row.Text</span>
                    <span>@HtmlHelpers.FormatNumber(row.Total.Wager)</span>
                    <span>@HtmlHelpers.FormatNumber(row.Total.Stake)</span>
                </li>
            }
        </ul>
    </li>
    @for (var i = 0; i < Model.HeaderTable.HeaderName.Count; i++)
    {
        <li>
            <span data-toggle="tooltip" data-placement="top" title="@Model.HeaderTable.ToolTip[i]">@Model.HeaderTable.HeaderName[i]</span>
            <ul>
                @for (var j = 0; j < Model.BySportType.Count(); j++)
                {
                    var row = Model.BySportType.ElementAt(j);
                    var sportColumn = row.SportsColumn[i];
                    <li>
                        <span>@row.Text</span>
                        <span>@HtmlHelpers.FormatNumberWithLink(sportColumn.Wager, row.Url(Model.PossType, sportColumn.SportTypeGroup), row.SubMenuId)</span>
                        <span>@HtmlHelpers.FormatNumberWithLink(sportColumn.Stake, row.Url(Model.PossType, sportColumn.SportTypeGroup), row.SubMenuId)</span>
                    </li>
                }
            </ul>
        </li>
    }
</ul>