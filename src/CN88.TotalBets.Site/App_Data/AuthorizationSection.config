<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[B],[D],[E],[H]"
  custIdQueryStringParamNameMapping="custid"
  custIdJsonParamNameMapping=""
  cachedExpireTime="30"
  kickOutUrl="~/auth/kickout">
  <!--
    [B]: Account Management Edit & View
    [D]: Total Bets
    [E]: Reports
    [H]: Account Management View Only
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="1.01.01" permission="[D]" mainfuncname="Total Bets" subfuncname="Event tab" url="Event/Index" ischeckbelonging="false" />
      <add id="1.01.02" permission="[D]" mainfuncname="Total Bets" subfuncname="Outright tab" url="Outright/Index" ischeckbelonging="false" />
      <add id="1.01.03" permission="[D]" mainfuncname="Total Bets" subfuncname="Overview tab" url="OverView/Index" ischeckbelonging="false" />
      <add id="1.01.04" permission="[D]" mainfuncname="Total Bets" subfuncname="View by bet type" url="ViewByBetType/Index" ischeckbelonging="false" />
      <add id="1.01.05" permission="[D]" mainfuncname="Total Bets" subfuncname="View by account" url="WagerAccount/GetByOutright" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.06" permission="[D]" mainfuncname="Total Bets" subfuncname="View by account" url="WagerAccount/GetByEvent" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.07" permission="[D]" mainfuncname="Total Bets" subfuncname="Started" url="Started/Index" ischeckbelonging="false" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>