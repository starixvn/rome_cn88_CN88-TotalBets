<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H]"
  custIdQueryStringParamNameMapping="custid"
  custIdJsonParamNameMapping=""
  cachedExpireTime="30"
  kickOutUrl="~/auth/kickout">
  <!--
    [A]: Create
    [B]: Update
    [C]: Transfer
    [D]: Total Bets
    [E]: Reports
    [F]: Forcast
    [H]: Member Information
    [G]: View Log
    [L]: Bet Lists
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="1.01.01" permission="[D]" mainfuncname="Report" subfuncname="Event tab" url="Event" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.02" permission="[D]" mainfuncname="Report" subfuncname="Outright tab" url="Outright" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.03" permission="[D]" mainfuncname="Report" subfuncname="Overview tab" url="OverView" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.04" permission="[D]" mainfuncname="Report" subfuncname="View by bet type" url="ViewByBetType" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.05" permission="[D]" mainfuncname="Report" subfuncname="View by account" url="WagerAccount/GetByOutright" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.06" permission="[D]" mainfuncname="Report" subfuncname="View by account" url="WagerAccount/GetByEvent" ischeckbelonging="true" isallowtodobythemselves="true" />      
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>