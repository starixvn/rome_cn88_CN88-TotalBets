<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H]"
  custIdQueryStringParamNameMapping="custid,CustId,custId"
  custIdJsonParamNameMapping="txtCustomerObject,newCustomer"
  ignoreUrls=""
  cachedExpireTime="30"
  kickOutUrl="~/default/kickout">
  <!-- [E]: Reports -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="1.01.01" permission="[E]" mainfuncname="Report" subfuncname="Winloss Detail" url="WinLossDetail" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.02" permission="[E]" mainfuncname="Report" subfuncname="EnteredResult" url="EnteredResult" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.03" permission="[E]" mainfuncname="Report" subfuncname="Winloss" url="WinLoss" ischeckbelonging="true" isallowtodobythemselves="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>