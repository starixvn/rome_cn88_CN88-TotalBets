<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H]"
  custIdQueryStringParamNameMapping="custid"
  custIdJsonParamNameMapping=""
  cachedExpireTime="30"
  kickOutUrl="~/auth/kickout">
  <!--
    [A]: Create
    [B]: Update
    [C]: Transfer
    [D]: Total Bets
    [E]: Reports
    [F]: Forcast
    [H]: Member Information
    [G]: View Log
    [L]: Bet Lists
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="1.01.01" permission="[D]" mainfuncname="Report" subfuncname="Winloss Detail" url="WinLossDetail" ischeckbelonging="true" isallowtodobythemselves="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>