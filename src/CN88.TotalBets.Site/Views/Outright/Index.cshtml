@using CN88.TotalBets.Models.Outright;
@using CN88.TotalBets.Site.ViewModels.Outright;
@{
    ViewBag.Title = "Outright";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/outright/outright")
}
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/outright/outright")
}
@model OutrightViewModel
<div class="main-content">
    <div class="page-title"></div>
    <form class="form-inline filter" role="form" id="outright-form">
        @StakeConditionFilter.Render(Model.StakeConditionFilterViewModel)
        @PossTypeSelection.Render(Model.PossType)
        @LeagueSelection.Render(Model.LeagueSelectionViewModel)
    </form>
    <table class="tbl-totalbet tbl-outright" id="tableOutright">
        <tbody>
            @foreach (var league in Model.Outrights)
            {
                @RenderLeague(league)
                var index = 0;
                foreach (var outright in league.Outrights)
                {
                    index++;
                    if (index % 2 == 1)
                    {
                        @:<tr class="childrow-@league.LeagueId">@RenderOutright(outright)
                    }
                    else
                    {
                        @:@RenderOutright(outright)</tr>
                    }
                }

                if (index % 2 == 1)
                {
                    @:<td>&nbsp;</td></tr>
                }
            }
        </tbody>
    </table>
</div>
@helper RenderLeague(OutrightLeague league)
{
    <tr class="league" data-leagueid="@league.LeagueId">
        <td colspan="2">
            <span class="league-name-wrapper">
                <span class="icon-chevron-down"></span>
                <span class="league-name">@league.LeagueName</span>
            </span>
            <span class="index text-right">@league.TotalWager | @HtmlHelpers.FormatNumber(league.TotalStake)</span>
        </td>
    </tr>
}
@helper RenderOutright(OutrightItem outright)
{
    <td class="team">
        <span class="team-name">@outright.TeamName</span>
        <span class="index text-right">@outright.Wager
            <a href="javascript:;" class="stake link">@HtmlHelpers.FormatNumber(outright.Stake)</a>
        </span>
    </td>
}
