@using CN88.TotalBets.Site.ViewModels.Outright;
@{
    ViewBag.Title = "Outright";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/outright")
}
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/outright/outright")
}
@model OutrightViewModel
<div class="main-content">
    @*<div class="page-title"></div>
    <form class="form-inline filter" role="form" id="report-form">
        @StakeConditionFilter.Render(Model.StakeConditionFilterViewModel)
        @PossTypeSelection.Render(Model.PossType)
        @LeagueSelection.Render(Model.LeagueSelectionViewModel)
    </form>
    <table class="table">
        <tbody>
            @foreach (var league in Model.Outrights)
            {
                <tr>
                    <td colspan="2">@league.LeagueName</td>
                </tr>
                int index = 0;
                foreach (var outright in league.Outrights)
                {
                    index++;
                    if (index % 2 == 1)
                    {
                        @:<tr><td>@outright.TeamName</td>
                    }
                    else
                    {
                        @:<td>@outright.TeamName</td></tr>
                    }
                }

                if (index % 2 == 1)
                {
                    @:<td>&nbsp;</td></tr>
                }
            }
        </tbody>
    </table>*@
    <table class="tbl-totalbet tbl-outright">
        <tbody>
            <tr class="league">
                <td colspan="3"><span class="icon-chevron-down"></span><span class="league-name">Autralia A League - Grand Final Winner</span></td>
                <td class="text-right">6 | 300.00</td>
            </tr>
            <tr>
                <td class="team">Melbourne Victory</td>
                <td class="text-right">2 <a class="stake">100.00</a></td>
                <td class="team">Perth Glory</td>
                <td class="text-right">2 <a class="stake">100.00</a></td>
            </tr>
            <tr>
                <td class="team">Sydney</td>
                <td class="text-right">2 <a class="stake">100.00</a></td>
                <td></td>
                <td></td>
            </tr>
        </tbody>
    </table>
</div>