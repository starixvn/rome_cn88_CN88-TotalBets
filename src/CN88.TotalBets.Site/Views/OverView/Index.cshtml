@model HomeViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/overview")
}
<div class="page-overview">
    <div class="page-title">@Resources.OverView</div>
    <form class="form-inline filter" role="form" id="overview-form">
        @PossTypeSelection.Render(Model.UserSelectedViewMode)
    </form>
    <table class="tbl-style2 tbl-totalbets">
        <tbody>
            <tr>
                <td>@Resources.TotalWarger</td>
                <td>@HtmlHelpers.FormatNumber(Model.Total.Wagers)</td>
            </tr>
            <tr>
                <td>@Resources.TotalStake</td>
                <td>@HtmlHelpers.FormatNumber(Model.Total.Stake)</td>
            </tr>
        </tbody>
    </table>

    <table class="tbl-style2 tbl-betdetail">
        <thead>
            <tr>
                <th></th>
                <th class="text-center">@Resources.AllSports</th>
                @for (var i = 0; i < Model.HeadTable.HeaderName.Count; i++)
		        {
                    <th><span data-toggle="tooltip" data-placement="top" title="@Model.HeadTable.ToolTip[i]">@Model.HeadTable.HeaderName[i]</span></th>
                }

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.BySportType)
            {
                <tr>
                    <td>@item.Text</td>
                    <td>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Total.Wagers, "")</span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Total.Stake, "")</span>
                    </td>
                    <td>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Soccer.Wagers, "")</span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Soccer.Stake, "")</span>
                    </td>
                    <td class="even">
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.Basketball.Wagers, "")
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Basketball.Stake, "")</span>
                    </td>
                    <td>
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.Tennis.Wagers, "")
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Tennis.Stake, "")</span>
                    </td>
                    <td class="even">
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.Volleyball.Wagers, "")
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Volleyball.Stake, "")</span>
                    </td>
                    <td>
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.TableTennis.Wagers, "")
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.TableTennis.Stake, "")</span>
                    </td>
                    <td class="even">
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.Badminton.Wagers, "")
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Badminton.Stake, "")</span>
                    </td>
                    <td>
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.Baseball.Wagers, "")
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Baseball.Stake, "")</span>
                    </td>
                    <td class="even">
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.Snooker.Wagers, "")
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.Snooker.Stake, "")</span>
                    </td>
                    <td>
                        <span>
                            @HtmlHelpers.FormatNumberWithLink(item.OtherSports.Wagers, "")
                        </span>
                        <span>@HtmlHelpers.FormatNumberWithLink(item.OtherSports.Stake, "")</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <table class="tbl-style2 tbl-betdetail">
        <thead>
            <tr>
                <th></th>
                <th class="text-center">@Resources.AllParlays</th>
                <th class="text-center">@Resources.Soccer</th>
                <th class="text-center">@Resources.NonSoccer</th>
                <th class="text-center">@Resources.MixSports</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.ByParlay.Text</td>
                <td>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.Total.Wagers, "")
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.Total.Stake, "")
                    </span>
                </td>
                <td>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.Soccer.Wagers, "")
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.Soccer.Stake, "")
                    </span>
                </td>
                <td class="even">
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.NonSoccer.Wagers, "")
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.NonSoccer.Stake, "")
                    </span>
                </td>
                <td>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.MixSports.Wagers, "")
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumberWithLink(Model.ByParlay.MixSports.Stake, "")
                    </span>
                </td>
            </tr>
        </tbody>
    </table>
</div>

@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/scripts/overview")
}