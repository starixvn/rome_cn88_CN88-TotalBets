@model HomeViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/totalbets")
}
<div class="page-overview">
    <div class="page-title">Overview</div>
    <form class="form-inline filte" role="form"></form>
    <table class="tbl-style2 tbl-totalbets">
        <tbody>
            <tr>
                <td>Total Warger</td>
                <td>@HtmlHelpers.FormatNumber(Model.Total.Wagers)</td>
            </tr>
            <tr>
                <td>Total Stake</td>
                <td>@HtmlHelpers.FormatNumber(Model.Total.Stake)</td>
            </tr>
        </tbody>
    </table>

    <table class="tbl-style2 tbl-betdetail">
        <thead>
            <tr>
                <th></th>
                <th>All Sports</th>
                <th>Soccer</th>
                <th>Basketball</th>
                <th>Tennis</th>
                <th>Volleyball</th>
                <th>Table Tennis</th>
                <th>Badminton</th>
                <th>Baseball</th>
                <th>Snnoker</th>
                <th>Other Sports</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.BySportType)
            {
                <tr>
                    <td>@item.Text</td>
                    <td>
                        <span>@HtmlHelpers.FormatNumber(item.Total.Wagers)</span>
                        <span>@HtmlHelpers.FormatNumber(item.Total.Stake)</span>
                    </td>
                    <td>
                        <span>@HtmlHelpers.FormatNumber(item.Soccer.Wagers)</span>
                        <span>@HtmlHelpers.FormatNumber(item.Soccer.Stake)</span>
                    </td>
                    <td class="even">
                        <span>
                            @HtmlHelpers.FormatNumber(item.Basketball.Wagers)
                        </span>
                        <span>@HtmlHelpers.FormatNumber(item.Basketball.Stake)</span>
                    </td>
                    <td>
                        <span>
                            @HtmlHelpers.FormatNumber(item.Tennis.Wagers)
                        </span>
                        <span>@HtmlHelpers.FormatNumber(item.Tennis.Stake)</span>
                    </td>
                    <td class="even">
                        <span>
                            @HtmlHelpers.FormatNumber(item.Volleyball.Wagers)
                        </span>
                        <span>@HtmlHelpers.FormatNumber(item.Volleyball.Stake)</span>
                    </td>
                    <td>
                        <span>
                            @HtmlHelpers.FormatNumber(item.TableTennis.Wagers)
                        </span>
                        <span>@HtmlHelpers.FormatNumber(item.TableTennis.Stake)</span>
                    </td>
                    <td class="even">
                        <span>
                            @HtmlHelpers.FormatNumber(item.Badminton.Wagers)
                        </span>
                        <span>@HtmlHelpers.FormatNumber(item.Badminton.Stake)</span>
                    </td>
                    <td>
                        <span>
                            @HtmlHelpers.FormatNumber(item.Baseball.Wagers)
                        </span>
                        <span>@HtmlHelpers.FormatNumber(item.Baseball.Stake)</span>
                    </td>
                    <td class="even">
                        <span>
                            @HtmlHelpers.FormatNumber(item.Snooker.Wagers)
                        </span>
                        <span>@HtmlHelpers.FormatNumber(item.Snooker.Stake)</span>
                    </td>
                    <td>
                        <span>
                            @HtmlHelpers.FormatNumber(item.OtherSports.Wagers)
                        </span>
                        <span>@HtmlHelpers.FormatNumber(item.OtherSports.Stake)</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <table class="tbl-style2 tbl-betdetail">
        <thead>
            <tr>
                <th></th>
                <th>All Parlays</th>
                <th>Soccer</th>
                <th>Non-Soccer</th>
                <th>Mix Sports</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.ByParlay.Text</td>
                <td>
                    <span>
                        @HtmlHelpers.FormatNumber(Model.ByParlay.Total.Wagers)
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumber(Model.ByParlay.Total.Stake)
                    </span>
                </td>
                <td>
                    <span>
                        @HtmlHelpers.FormatNumber(Model.ByParlay.Soccer.Wagers)
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumber(Model.ByParlay.Soccer.Stake)
                    </span>
                </td>
                <td class="even">
                    <span>
                        @HtmlHelpers.FormatNumber(Model.ByParlay.NonSoccer.Wagers)
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumber(Model.ByParlay.NonSoccer.Stake)
                    </span>
                </td>
                <td>
                    <span>
                        @HtmlHelpers.FormatNumber(Model.ByParlay.MixSports.Wagers)
                    </span>
                    <span>
                        @HtmlHelpers.FormatNumber(Model.ByParlay.MixSports.Stake)
                    </span>
                </td>
            </tr>
        </tbody>
    </table>
</div>
