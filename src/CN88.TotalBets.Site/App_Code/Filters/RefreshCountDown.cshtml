@using CN88.TotalBets.AppResources
@helper Render(IEnumerable<int> countDownSecs)
{
    <div class="dropdown-refresh">
        <div class="btnCountDown">
            <div class="icon-refresh"></div>
            <div class="btn-show-options">
                <span id="CountDownRefresh" class="btnRefresh" title="@Resources.Refresh"
                     data-loading-text="@Resources.Loading"></span>
            </div>
        </div>
        <ul id="CountDownMenu" class="list-options hide">
            @foreach (var countDownSec in countDownSecs)
            {
                <li id="option_@countDownSec" class="count-down-option" data-value="@countDownSec">
                    @countDownSec
                </li>
            }
            <li id="count-down-off" class="count-down-option" data-value="-1">@Resources.Off</li>
        </ul>
    </div>
}