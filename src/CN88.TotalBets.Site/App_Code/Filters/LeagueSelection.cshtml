@using CN88.TotalBets.AppResources
@using CN88.TotalBets.Site.ViewModels.Filters
@helper Render(SingleSelectionViewModel model)
{
    <div class="form-group dropdown-league">
        <label>@Resources.League</label>
        <select id="dropdown-league">
            @foreach (var item in model.Items)
            {
                <option value="@item.Value" @(item.Selected ? " selected=\"selected\"" : string.Empty)>@item.Text</option>
            }
        </select>
        <input type="hidden" name="LeagueId" id="LeagueId" value="@model.UserSelectedId" />
    </div>
}