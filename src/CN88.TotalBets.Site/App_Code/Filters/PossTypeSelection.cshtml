@using CN88.TotalBets.AppResources
@using CN88.TotalBets.Shared.Constants
@using CN88.TotalBets.Site.Shared.ViewModels.Filters
@helper Render(SingleSelectionViewModel model)
{
    <div class="form-group dropdown-poss-type">
        <label>@Resources.View</label>
        <select id="dropdown-poss-type">
            @foreach (var item in model.Items)
            {
                <option value="@item.Value" @(item.Selected ? " selected=\"selected\"" : string.Empty)>@item.Text</option>
            }
        </select>
        <input type="hidden" name="PossType" id="PossType" value="@model.UserSelectedId" />
    </div>
}