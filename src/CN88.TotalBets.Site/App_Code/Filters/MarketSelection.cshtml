@using CN88.TotalBets.AppResources
@using CN88.TotalBets.Shared.Constants
@helper Render(int selectedMarket)
{
    <div class="form-group">
        <label>@Resources.Market</label>
        <select id="dropdown-market">
            <option value="@MarketConstants.AllMarkets" @(MarketConstants.AllMarkets == selectedMarket ? " selected=\"selected\"" : string.Empty)>@Resources.AllMarkets</option>
            <option value="@MarketConstants.PreMatch" @(MarketConstants.PreMatch == selectedMarket ? " selected=\"selected\"" : string.Empty)>@Resources.PreMatch</option>
            <option value="@MarketConstants.InPlay" @(MarketConstants.InPlay == selectedMarket ? " selected=\"selected\"" : string.Empty)>@Resources.InPlay</option>
        </select>
        <input type="hidden" name="Market" id="Market" value="@selectedMarket" />
    </div>
}
