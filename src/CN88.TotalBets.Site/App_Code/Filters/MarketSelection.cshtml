@using CN88.TotalBets.AppResources
@using CN88.TotalBets.Site.Shared.ViewModels.Filters
@helper Render(MarketSelectionViewModel model)
{
    <div class="form-group">
        <label>@Resources.Market</label>
        <select id="dropdown-market">
            @foreach (var item in model.Items)
            {
                <option value="@item.Value" @(item.Selected ? " selected=\"selected\"" : string.Empty)>@item.Text</option>
            }
        </select>
        <input type="hidden" name="Market" id="Market" value="@model.SelectedMarket" />
    </div>
}