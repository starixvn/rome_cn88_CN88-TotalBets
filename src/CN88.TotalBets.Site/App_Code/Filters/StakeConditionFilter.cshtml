@using CN88.TotalBets.AppResources
@using CN88.TotalBets.Shared.Constants
@helper Render(byte stakeCondition, decimal stake)
{
    <div class="form-group dropdown-stake-condition">
        <label>@Resources.MemberStake</label>
        <select id="dropdown-stake-condition">
            <option value="@StakeConditionConstants.GreaterThan" @(StakeConditionConstants.GreaterThan == stakeCondition ? " selected=\"selected\"" : string.Empty)>></option>
            <option value="@StakeConditionConstants.LessThan" @(StakeConditionConstants.LessThan == stakeCondition ? " selected=\"selected\"" : string.Empty)><</option>
            <option value="@StakeConditionConstants.Equal" @(StakeConditionConstants.Equal == stakeCondition ? " selected=\"selected\"" : string.Empty)>=</option>
        </select>
        <input type="hidden" name="StakeCondition" id="StakeCondition" value="@stakeCondition" />
        <input type="text" name="Stake" id="Stake" value="@stake" />
    </div>
}