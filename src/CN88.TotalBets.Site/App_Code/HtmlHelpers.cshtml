@helper FormatNumber(decimal value)
{
    @value.ToString("#,##0.00")
}

@helper FormatNumber(int value)
{
    @value.ToString("#,##0")
}

@helper FormatNumberWithLink(decimal value, string link, string submenuId)
{
    if (value == 0)
    {
        @value.ToString("#,##0.00")
    }
    else
    {
        <a data-submenuid="sub-menu-@submenuId" href="@link" class="link">@value.ToString("#,##0.00")</a>
    }
}

@helper FormatNumberWithLink(int value, string link, string submenuId)
{
    if (value == 0)
    {
        @value.ToString("#,##0")
    }
    else
    {
        <a data-submenuid="sub-menu-@submenuId" href="@link" class="link">@value.ToString("#,##0")</a>
    }
}

@helper ShowTime(DateTime showTime, bool offerLive, bool showMonthDay)
{
    var localShowTime = showTime.AddHours(-4);

    if (showMonthDay)
    {
        @localShowTime.ToString("MM-dd")<br/>
    }
    
    @localShowTime.ToString("HH:mm")

    if (offerLive)
    {
        <br/><span class="live">@CN88.TotalBets.AppResources.Resources.Live</span>
    }
}