@helper FormatNumber(decimal value)
{
    @value.ToString("#,##0.00")
}

@helper FormatNumber(int value)
{
    @value.ToString("#,##0")
}

@helper FormatNumberWithLink(decimal value, string link)
{
    if (value == 0)
    {
        @value.ToString("#,##0.00")
    }
    else
    {
        <a href="@link">@value.ToString("#,##0.00")</a>
    }
}

@helper FormatNumberWithLink(int value, string link)
{
    if (value == 0)
    {
        @value.ToString("#,##0")
    }
    else
    {
        <a href="@link">@value.ToString("#,##0")</a>
    }
}