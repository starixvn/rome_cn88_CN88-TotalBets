@helper FormatNumber(decimal value)
{
    @value.ToString("#,##0.00")
}

@helper FormatNumber(int value)
{
    @value.ToString("#,##0")
}

@helper FormatNumberWithLink(decimal value, string link, string submenuId)
{
    if (value == 0)
    {
        @value.ToString("#,##0.00")
    }
    else
    {
        <a data-submenuid="sub-menu-@submenuId" href="@link" class="link">@value.ToString("#,##0.00")</a>
    }
}

@helper FormatNumberWithLink(int value, string link, string submenuId)
{
    if (value == 0)
    {
        @value.ToString("#,##0")
    }
    else
    {
        <a data-submenuid="sub-menu-@submenuId" href="@link" class="link">@value.ToString("#,##0")</a>
    }
}

@helper ShowTime(DateTime showTimeDT, bool offerLive, bool isToday)
{
    var localDateTime = showTimeDT.AddHours(-4);

    if (isToday)
    {
        @localDateTime.ToString("HH:mm")<br/><span class="live">LIVE</span>
    }
    else
    {
        @localDateTime.ToString("MM-dd")<br/>@localDateTime.ToString("HH:mm")<br/><span class="live">LIVE</span>
    }
}