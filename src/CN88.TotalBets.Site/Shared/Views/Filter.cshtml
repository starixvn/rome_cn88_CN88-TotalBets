@model FilterViewModel
<form class="form-inline filter" role="form" id="filter-form">
    @StakeConditionFilter.Render(Model.StakeCondition, Model.Stake)
    @if (Model.IsShowDateSelection)
    {
        @DateSelection.Render(Model.DateSelectionViewModel)
    }
    @PossTypeSelection.Render(Model.PossTypeSelectionViewModel)
    @if (Model.IsShowMarketSelection)
    {
        @MarketSelection.Render(Model.MarketSelectionViewModel)
    }
    @if (Model.IsShowLeagueSelection)
    {
        @LeagueSelection.Render(Model.LeagueSelectionViewModel)
    }
    @Html.Hidden(nameof(Model.SportTypeGroup), Model.SportTypeGroup)
    @foreach (var keyValue in Model.HiddenParams)
    {
        @Html.Hidden(keyValue.Key, keyValue.Value)
    }
    <input type="submit" value="@Resources.Submit" class="btn-submit" />
</form>